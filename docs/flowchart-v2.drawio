y x="422" y="2298" width="260" height="26" as="geometry"/></mxCell><mxCell id="leg9" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#AAAAAA;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="2334" width="40" height="24" as="geometry"/></mxCell><mxCell id="legl9" value="Temporary conversation context" style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="422" y="2334" width="260" height="26" as="geometry"/></mxCell><mxCell id="leg_d" value="Dashed arrow = wireless link (BLE, Wi-Fi or internet). Solid arrow = step inside one device." style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="2190" width="400" height="80" as="geometry"/></mxCell><mxCell id="note" value="&lt;b style=&#x27;color:#F2C744&#x27;&gt;Team to confirm: phone as the bridge&lt;/b&gt;&lt;br&gt;The earpiece talks only to the phone. BLE (always on) carries buttons, commands, live audio and voice lines. Wi-Fi turns on only to send saved 30 s clips (earpiece&#x27;s own network or the phone&#x27;s hotspot). The phone uses its own internet to reach the cloud, so the earpiece never needs campus Wi-Fi. The original chart had the earpiece upload straight to the cloud over Wi-Fi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E2608;strokeColor=#F2C744;dashed=1;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1785" y="2080" width="750" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>